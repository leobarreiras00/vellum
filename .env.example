# PostgreSQL
DATABASE_URL="postgresql://vellum:vellum@localhost:5432/vellum?schema=public"

# Sessão (Fase 1B): segredo HMAC do cookie de sessão, mínimo 32 caracteres.
# Gerar com: openssl rand -base64 32   (obrigatório em produção)
AUTH_SECRET=""

# Perfis de demonstração RBAC no ecrã de login (true/false).
# Por omissão: ativos em desenvolvimento, desativados em produção.
VELLUM_DEMO_AUTH=""

# Workspace Engine (Fase 2): ficheiro JSON local com projetos, páginas e notas.
# Por omissão: .data/workspace.json. Apagar o ficheiro repõe o seed editorial.
VELLUM_DATA_FILE=""
