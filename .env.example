# =============================================================================
# Vellum — Variáveis de ambiente (modelo)
# © 2026 Leonardo Barreiras. Todos os direitos reservados.
#
# Copie para `.env.local` (ignorado pelo git) e preencha. NUNCA coloque segredos
# reais neste ficheiro: ele é versionado.
# =============================================================================

# --- Obrigatórias em produção -------------------------------------------------
# Segredo da sessão/assinatura (≥ 32 caracteres aleatórios). Ex.: openssl rand -base64 48
AUTH_SECRET=
# URL público da aplicação (cookies seguros, ligações nos emails, metadados).
BETTER_AUTH_URL=http://localhost:3000

# --- Armazenamento ------------------------------------------------------------
# "json" (por omissão, ficheiro local) ou "postgres".
VELLUM_STORE=json
VELLUM_DATA_FILE=.data/workspace.json
# Só com VELLUM_STORE=postgres.
DATABASE_URL=
# "false" cria os espaços novos sem os documentos de exemplo.
VELLUM_EXAMPLE_DATA=true

# --- Proxy / limites de pedidos -----------------------------------------------
# Nº de proxies de confiança à frente da aplicação (Railway = 1; aceita 1 a 5, outro
# valor cai em 1). O IP do cliente é lido do X-Forwarded-For contando a partir da
# direita, porque o que vem antes pode ser forjado pelo cliente.
VELLUM_PROXY_HOPS=1

# --- Contas de demonstração (OFF por omissão) ---------------------------------
# Em produção só ficam ativas com VELLUM_DEMO_AUTH=true E uma palavra-passe PRIVADA
# (≥ 12 caracteres, diferente da que está documentada). As contas demo nunca são
# SUPER_ADMIN, salvo VELLUM_DEMO_SUPER_ADMIN=true (reservado aos testes E2E).
VELLUM_DEMO_AUTH=false
VELLUM_DEMO_PASSWORD=
VELLUM_DEMO_SUPER_ADMIN=false

# --- Content-Security-Policy --------------------------------------------------
# "enforce" (por omissão), "report-only" (só regista violações na consola do
# navegador) ou "off" (kill switch de emergência).
VELLUM_CSP=enforce

# --- Email (códigos de verificação, convites, suporte) -------------------------
# Sem fornecedor, o modo de desenvolvimento mostra a caixa de entrada em /dev/caixa.
# EMAIL_PROVIDER=brevo        # ou "resend"; deduz-se da chave presente
# BREVO_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=Vellum
# SUPPORT_EMAIL=

# --- Build / deploy -----------------------------------------------------------
# "standalone" é usado pelo Dockerfile.
# NEXT_OUTPUT=standalone

# --- Testes (não usar em produção) --------------------------------------------
# E2E_DATABASE_URL=postgresql://vellum:…@localhost:5432/vellum_e2e   # nome com «e2e»; é esvaziada
# VELLUM_TEST_URL=http://127.0.0.1:3100                              # npm run test:http
