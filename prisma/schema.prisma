//
// Dois blocos:
//  1. Auth (Better-Auth): user, session, account, verification. Os campos
//     extra do utilizador (papéis, tema, atelier) são `additionalFields`.
//  2. Workspace Engine: uma tabela por coleção de `StoreData`
//     (src/lib/workspace-types.ts), com as mesmas colunas e os mesmos valores
//     (as tintas e papéis usam os mesmos literais que o TypeScript). O
//     repositório (src/lib/store/postgres.ts) lê e grava estas tabelas em
//     transação, com bloqueio consultivo e número de revisão (`store_meta`).
//
// Eliminação lógica (`deletedAt`) para conteúdo do utilizador. RBAC:
// .claude/skills/security-rbac-guard.md
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums (literais iguais aos do TypeScript)
// -----------------------------------------------------------------------------

/// Papel ao nível da plataforma.
enum PlatformRole {
  USER
  SUPER_ADMIN
}

/// Papel RBAC (hierarquia: OWNER > EDITOR > COMMENTER > VIEWER).
enum WorkspaceRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

/// Tintas de projetos, notas e legendas.
enum InkColor {
  terracota
  salvia
  ardosia
  ocre
  ameixa
  grafite
}

enum ReadingFont {
  serif
  sans
}

enum CommentKind {
  comment
  suggestion
  question
}

enum EffortKind {
  tracked
  focus
}

// -----------------------------------------------------------------------------
// Módulo 1 — Auth (Better-Auth)
// -----------------------------------------------------------------------------

model User {
  id              String        @id
  name            String
  email           String        @unique
  emailVerified   Boolean       @default(false)
  image           String?
  /// Username único, minúsculas, [a-z0-9._-] (plugin `username`).
  username        String?       @unique
  displayUsername String?
  platformRole    PlatformRole  @default(USER)
  /// Papel por omissão no atelier criado no registo.
  workspaceRole   WorkspaceRole @default(OWNER)
  workspaceName   String        @default("Atelier")
  /// Um dos 5 temas (`warm-cream`, `sage-paper`, `nordic-slate`, `sand-dune`, `dark-espresso`).
  theme           String        @default("warm-cream")
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash scrypt (`scrypt$salt$hash`, src/lib/auth-password.ts).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Códigos de uso único (recuperação de palavra-passe por código de 6 algarismos).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -----------------------------------------------------------------------------
// Módulo 2 — Workspace Engine
// -----------------------------------------------------------------------------

/// Revisão do repositório: sobe a cada gravação; as instâncias recarregam quando muda.
model StoreMeta {
  id        Int      @id @default(1)
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("store_meta")
}

model Workspace {
  id        String   @id
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime

  members   WorkspaceMember[]
  projects  Project[]
  documents Document[]

  @@map("workspace")
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole
  joinedAt    DateTime
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

/// Diretório de pessoas do workspace (nome e email mostrados nas listas).
model Person {
  id           String       @id
  name         String
  email        String
  platformRole PlatformRole

  @@map("person")
}

model UserPreference {
  userId           String      @id
  theme            String
  dailyGoalMinutes Int
  readingFont      ReadingFont

  @@map("user_preference")
}

model Project {
  id          String    @id
  workspaceId String
  createdById String
  name        String
  description String
  icon        String
  color       InkColor
  position    Int
  createdAt   DateTime
  updatedAt   DateTime
  deletedAt   DateTime?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  documents Document[]

  @@index([workspaceId, deletedAt])
  @@map("project")
}

model ProjectMember {
  projectId String
  userId    String
  role      WorkspaceRole
  addedAt   DateTime
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

model Document {
  id             String    @id
  workspaceId    String
  projectId      String
  parentId       String?
  createdById    String
  lastEditedById String
  title          String
  summary        String
  /// Texto simples derivado (pesquisa e contagem de palavras).
  plainText      String
  /// JSON ProseMirror do editor rico.
  contentJson    Json?
  version        Int
  wordCount      Int
  position       Int
  createdAt      DateTime
  updatedAt      DateTime
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deletedAt])
  @@index([projectId, parentId])
  @@map("document")
}

model QuickNote {
  id          String    @id
  userId      String
  workspaceId String
  projectId   String?
  documentId  String?
  title       String
  content     String
  color       InkColor
  isPinned    Boolean
  createdAt   DateTime
  updatedAt   DateTime
  deletedAt   DateTime?

  @@index([workspaceId, deletedAt])
  @@map("quick_note")
}

model DocumentComment {
  id           String      @id
  workspaceId  String
  documentId   String
  authorId     String
  kind         CommentKind
  quote        String
  body         String
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime
  deletedAt    DateTime?

  @@index([documentId])
  @@map("document_comment")
}

model EffortLog {
  id            String     @id
  userId        String
  workspaceId   String
  projectId     String?
  documentId    String?
  startedAt     DateTime
  activeSeconds Int
  wordsWritten  Int
  edits         Int
  kind          EffortKind
  updatedAt     DateTime

  @@index([workspaceId, userId, startedAt])
  @@map("effort_log")
}

model CalendarLegend {
  id          String    @id
  workspaceId String
  name        String
  color       InkColor
  position    Int
  createdAt   DateTime
  deletedAt   DateTime?

  @@index([workspaceId])
  @@map("calendar_legend")
}

model CalendarEvent {
  id              String    @id
  workspaceId     String
  createdById     String
  title           String
  /// Dia (AAAA-MM-DD, Lisboa).
  date            String
  startTime       String?
  endTime         String?
  allDay          Boolean
  projectId       String?
  documentId      String?
  legendId        String?
  isImportant     Boolean
  reminderMinutes Int?
  notes           String
  externalUid     String?
  /// Regra de repetição ({ freq, interval, byWeekday, until, count }) ou null.
  recurrence      Json?
  /// Ocorrências apagadas de uma série (AAAA-MM-DD).
  exdates         String[]  @default([])
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?

  @@index([workspaceId, date])
  @@map("calendar_event")
}

model DayNote {
  id          String   @id
  workspaceId String
  userId      String
  date        String
  content     String
  documentIds String[]
  updatedAt   DateTime

  @@unique([workspaceId, userId, date])
  @@map("day_note")
}

model ImportedSnapshot {
  workspaceId String
  snapshotId  String
  importedAt  DateTime

  @@id([workspaceId, snapshotId])
  @@map("imported_snapshot")
}
